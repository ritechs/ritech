{
	email {$ACME_EMAIL}
	servers {
		# Only Caddy itself sets the client address the app sees.
		trusted_proxies static private_ranges
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Bodies above 12 MB are refused before they reach the app (largest upload is 10 MB).
	request_body {
		max_size 12MB
	}

	# Never expose internal paths.
	@internal path /internal/*
	respond @internal 404

	reverse_proxy web:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Request-Id {http.request.uuid}
	}

	log {
		output stdout
		format json
	}
}
