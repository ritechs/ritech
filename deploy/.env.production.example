# RiTECHS — production settings for docker compose.
# On the server: copy to `.env` next to docker-compose.yml and fill in every value.
# Generate secrets with: openssl rand -base64 48

DOMAIN=ritechs.org
ACME_EMAIL=info@ritechs.org

# Database roles: the owner runs migrations only; the app role is least-privilege.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

BETTER_AUTH_SECRET=
INTERNAL_API_TOKEN=
REVALIDATE_SECRET=

# Outgoing email (required in production), e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=RiTECHS <no-reply@ritechs.org>
# Receives alerts about automatic IP blocks
SECURITY_ALERT_EMAIL=info@ritechs.org

# Optional: Cloudflare Turnstile bot check
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: S3-compatible storage for uploads (Cloudflare R2, AWS S3). Default: a local volume.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=

# Two-step verification (authenticator app) is optional for everyone by default.
# Recommended once the site is live: true makes admins turn it on before using the admin area.
REQUIRE_STAFF_2FA=false
