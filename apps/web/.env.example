# RiTECHS website — copy to apps/web/.env.local (Next.js reads env files from its own folder).
# INTERNAL_API_TOKEN and REVALIDATE_SECRET must match the values in the root .env.

API_INTERNAL_URL=http://127.0.0.1:4000
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters-1111
REVALIDATE_SECRET=replace-with-at-least-24-random-characters

# Optional: Cloudflare Turnstile site key (bot check on sign-in)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
