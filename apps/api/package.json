{
  "name": "@ritechs/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "RiTECHS API (NestJS + Better Auth + Drizzle/PostgreSQL).",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "dev:worker": "node scripts/dev.mjs worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "admin:create": "node --env-file-if-exists=../../.env dist/cli/create-admin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "legacy:import": "node --env-file-if-exists=../../.env dist/cli/legacy-import.js",
    "legacy:assets": "node --env-file-if-exists=../../.env dist/cli/legacy-assets.js",
    "2fa:off": "node --env-file-if-exists=../../.env dist/cli/two-factor-off.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@ritechs/db": "*",
    "@ritechs/shared": "*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.2.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
