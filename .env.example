# RiTECHS — local development settings (repository root).
# Copy to `.env` and adjust. Never commit `.env`.
# Every line must be NAME=value; notes go on their own line after "#".

NODE_ENV=development

# PostgreSQL (your local server, e.g. PostgreSQL 18 managed with pgAdmin)
DATABASE_URL=postgres://ritechs:change-me@127.0.0.1:5432/ritechs
# Separate, empty database for `npm test` (it is wiped on every test run)
TEST_DATABASE_URL=postgres://ritechs:change-me@127.0.0.1:5432/ritechs_test

# Where the website runs
WEB_URL=http://localhost:3000

# Secrets: any long random strings in development, e.g. `openssl rand -base64 48`
# or in PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-0000
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters-1111
REVALIDATE_SECRET=replace-with-at-least-24-random-characters

# The Next.js dev server proxies /api to the API from this machine
TRUSTED_PROXIES=127.0.0.1/32,::1/128
WEB_REVALIDATE_URL=http://127.0.0.1:3000/internal/revalidate

# Two-step verification (authenticator app) is optional for everyone, admins included.
# Set to true to make admins turn it on before they can use the admin area.
REQUIRE_STAFF_2FA=false
PASSWORD_BREACH_CHECK=false
WORKER_IN_PROCESS=true
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# No SMTP in development: emails (verification and reset links) are printed in the API console.
# SMTP_URL=smtp://user:password@localhost:1025
